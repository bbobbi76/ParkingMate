# 백엔드(Spring Boot) 환경 변수 예시
#
# 로컬 개발은 아무것도 안 넣어도 된다: H2 파일 DB(backend/data), 관리자 키 dev-admin, 센서 키 dev-sensor, 포트 8787.
# Spring Boot 는 .env 파일을 자동으로 읽지 않는다. 값을 쓰려면 아래 중 하나로 넣는다.
#   - 배포(Render): 대시보드 → parkingmate-api → Environment 에 같은 이름으로 입력
#   - 로컬 PowerShell:  $env:ADMIN_KEY="..."; ./gradlew bootRun
#   - IntelliJ: Run Configuration → Environment variables
# 실제 값을 이 파일에 적어 커밋하지 않는다. 복사본(backend/.env)은 .gitignore 로 제외된다.

# ── DB ──
# 비우면 로컬 H2. 배포는 Neon 의 연결 주소(jdbc:postgresql://<host>/<db>?sslmode=require)
DATABASE_URL=
# 주소에 사용자·비밀번호가 들어 있지 않으면 따로 입력
DATABASE_USERNAME=
DATABASE_PASSWORD=

# ── 서버 ──
# Render 는 PORT 를 자동으로 넣어 준다. 로컬 기본 8787
PORT=8787
# 프론트 주소(쉼표로 여러 개, * 패턴 가능). 예: https://*.vercel.app,http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── 키 (32자 이상 무작위 문자열 권장. 팀 채팅·슬라이드에 쓰지 않기) ──
# 현장 관리 화면·관리 API 키
ADMIN_KEY=
# true 면 관리 화면을 키 없이 사용(발표·시연 기간에만). 끝나면 false
ADMIN_OPEN=false
# 노트북 센서 브리지가 보내는 X-Sensor-Key 와 같은 값
SENSOR_KEY=

# ── 시연 ──
# 축제 날 시각부터 서버 시계가 흐르게 함(셔틀 운행·버스 위치 시연용). 평소에는 비움 = 실제 현재 시각
# 예: 2027-01-16T09:30
DEMO_CLOCK=
