# 노트북에서 돌리는 스크립트(sensor/bridge.py, sensor/simulate.py, tools/demo_setup.py)용 값 예시
# 파이썬 스크립트는 .env 파일을 자동으로 읽지 않는다. PowerShell 에서 먼저 넣고 실행한다.
#   $env:SENSOR_KEY="..."; python sensor/bridge.py --api $env:API_BASE --serial COM5
#   $env:ADMIN_KEY="...";  python tools/demo_setup.py --api $env:API_BASE
# 실제 값은 커밋하지 않는다.

# 보낼 서버. 로컬 리허설은 http://127.0.0.1:8787, 배포는 https://parkingmate-api.onrender.com
API_BASE=http://127.0.0.1:8787

# 서버의 SENSOR_KEY 와 같은 값 (로컬 기본 dev-sensor). 브리지·시뮬레이터가 사용
SENSOR_KEY=dev-sensor

# 서버의 ADMIN_KEY 와 같은 값 (로컬 기본 dev-admin). tools/demo_setup.py 가 사용
ADMIN_KEY=dev-admin

# STM32 가 연결된 COM 포트 (장치 관리자 → 포트(COM & LPT) → STLink Virtual COM Port)
STM32_PORT=COM5

# ── Pico 2 WH 펌웨어(sensor/pico_exit/main.py)에는 아래 값을 파일 맨 위에 직접 적는다(커밋 전 비우기) ──
# WIFI_SSID / WIFI_PASS : 노트북과 같은 와이파이(휴대폰 핫스팟 권장)
# BRIDGE                : http://<노트북 IP>:9000/event   (ipconfig 로 IP 확인)
